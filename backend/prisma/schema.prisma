// Prisma schema for P-Ionna Travel.
// Designed so it can later migrate to PostgreSQL by changing the datasource
// provider to "postgresql" and the DATABASE_URL — the field types are all
// portable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trips        Trip[]
  walletEntries WalletEntry[]
  bookings     Booking[]
  chatMessages ChatMessage[]
}

model Trip {
  id          String   @id @default(cuid())
  userId      String
  name        String
  destination String
  country     String
  imageUrl    String?
  startDate   DateTime
  endDate     DateTime
  budget      Float    @default(0)
  currency    String   @default("USD")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletEntries  WalletEntry[]
  bookings       Booking[]

  @@index([userId])
}

model WalletEntry {
  id          String   @id @default(cuid())
  userId      String
  tripId      String?
  title       String
  description String?
  amount      Float
  currency    String   @default("USD")
  category    String   // FLIGHT | HOTEL | FOOD | TRANSPORT | ACTIVITY | SHOPPING | OTHER
  type        String   // EXPENSE | INCOME
  date        DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip Trip? @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([tripId])
}

model Booking {
  id              String   @id @default(cuid())
  userId          String
  tripId          String?
  type            String   // FLIGHT | HOTEL
  status          String   @default("CONFIRMED") // CONFIRMED | CANCELLED | PENDING
  reference       String   @unique
  // common
  title           String
  fromCity        String?
  toCity          String?
  startDate       DateTime
  endDate         DateTime?
  price           Float
  currency        String   @default("USD")
  // flight-specific
  flightNumber    String?
  airline         String?
  departureTime   DateTime?
  arrivalTime     DateTime?
  cabinClass      String?
  // hotel-specific
  hotelName       String?
  hotelAddress    String?
  rating          Float?
  // metadata
  imageUrl        String?
  passengers      Int      @default(1)
  metadata        String?  // JSON string for arbitrary extras
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip Trip? @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([tripId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String   // USER | ASSISTANT
  content   String
  metadata  String?  // optional JSON (suggestions, itinerary, etc.)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
